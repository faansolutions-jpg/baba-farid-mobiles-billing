# Baba Farid Mobiles — Backend environment variables
# Copy to .env and fill in real values. Never commit .env to git.

# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins for the Flutter app / web admin.
# Use * only for local development.
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# PostgreSQL (server database). Run database/schema.sql against this DB first.
DATABASE_URL=postgres://shopuser:StrongPassword123@localhost:5432/shopdb

# JWT — generate long random secrets, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing (bcrypt cost factor, 12 = spec)
BCRYPT_ROUNDS=12

# Login rate limiting (per IP, per 15 minutes)
LOGIN_RATE_LIMIT_MAX=5
